bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_lua", version = "0.0.0")
local_path_override(
    module_name = "rules_lua",
    path = "..",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_foreign_cc", version = "0.17.0")

# Use the host make, as building it from source runs hundreds of slow autoconf check actions
foreign_cc_tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
foreign_cc_tools.make(mode = "system")

bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains(
    # Registered first so they win over the glibc 2.17 default
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
)

bazel_dep(name = "rules_lua_luaunit", version = "0.0.0")
local_path_override(
    module_name = "rules_lua_luaunit",
    path = "../luaunit",
)

bazel_dep(name = "rules_lua_busted", version = "0.0.0")
local_path_override(
    module_name = "rules_lua_busted",
    path = "../busted",
)

lua_deps = use_extension("@rules_lua//lua:defs.bzl", "lua_dependency")

