load("@rules_lua//fennel:defs.bzl", "fennel_binary", "fennel_library")
load("@rules_lua_luaunit//:defs.bzl", "fennel_luaunit_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

fennel_library(
    name = "example",
    srcs = [":example.fnl"],
)

fennel_binary(
    name = "main",
    tool = "main.fnl",
    deps = [":example"],
)

sh_test(
    name = "main_outside_runfiles_test",
    srcs = ["main_outside_runfiles_test.sh"],
    args = ["$(rootpath :main)"],
    data = [":main"],
)

fennel_luaunit_test(
    name = "example_test",
    srcs = ["test_example.fnl"],
    deps = [":example"],
)
