module(
    name = "rules_lua_luaunit",
    version = "0.0.1",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

bazel_dep(name = "rules_foreign_cc", version = "0.17.0", dev_dependency = True)

# Use the host make, as building it from source runs hundreds of slow autoconf check actions
foreign_cc_tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools", dev_dependency = True)
foreign_cc_tools.make(mode = "system")

bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains", dev_dependency = True)
use_repo(toolchains, "zig_sdk")

register_toolchains(
    # Registered first so they win over the glibc 2.17 default
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
    dev_dependency = True,
)

bazel_dep(name = "rules_lua", version = "0.0.0")
local_path_override(
    module_name = "rules_lua",
    path = "..",
)

lua_deps = use_extension("@rules_lua//lua:defs.bzl", "lua_dependency")
lua_deps.github(
    dependency = "luaunit",
    rockspec_path = "luaunit-3.4-1.rockspec",
    sha256 = "b8aea5826f09749d149efa8ef1b13f81e6a9fc6abfbe4c1cbf87a558a6d4e8d0",
    tag = "LUAUNIT_V3_4",
    user = "bluebird75",
)
use_repo(lua_deps, "lua_luaunit")

lua_toolchains = use_extension("@rules_lua//lua:repositories.bzl", "lua_toolchains")
lua_toolchains.lua(
    name = "lua",
    version = "v5.4.6",
)
use_repo(lua_toolchains, "lua_toolchains")

register_toolchains("@lua_toolchains//:all")

fennel_toolchains = use_extension("@rules_lua//fennel:repositories.bzl", "fennel_toolchains")
fennel_toolchains.fennel(
    name = "fennel",
    version = "1.4.0",
)
use_repo(fennel_toolchains, "fennel_toolchains")

register_toolchains("@fennel_toolchains//:fennel_toolchain")
